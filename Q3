import java.util.*;

public class placement3 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("Enter boundary:");
        int s1 = sc.nextInt();
        int s2 = sc.nextInt();
        sc.nextLine();

        System.out.print("Enter start: ");
        String start = sc.nextLine();

        System.out.println("Enter instructions:");
        String instructions = sc.nextLine();

        int x = Integer.parseInt(start.substring(0, 1));
        int y = Integer.parseInt(start.substring(2, 3));
        char d = start.charAt(4);

        for (int i = 0; i < instructions.length(); i++) {
            char c = instructions.charAt(i);

            if (c == ' ') {
                continue;
            }

            int oldX = x;
            int oldY = y;
            char oldD = d;

            if (c == 'L') {
                if (d == 'N') d = 'W';
                else if (d == 'W') d = 'S';
                else if (d == 'S') d = 'E';
                else if (d == 'E') d = 'N';
            }
            else if (c == 'R') {
                if (d == 'N') d = 'E';
                else if (d == 'E') d = 'S';
                else if (d == 'S') d = 'W';
                else if (d == 'W') d = 'N';
            }
            else if (c == 'M') {
                if (d == 'N') y++;
                else if (d == 'E') x++;
                else if (d == 'S') y--;
                else if (d == 'W') x--;
            }
            else {
                System.out.println("Invalid instruction: " + c);
                return;
            }

            if (x < -s1 || x > s1 || y < -s2 || y > s2) {

                x = oldX;
                y = oldY;
                d = oldD;

                System.out.println(x + "-" + y + "-" + d + "-ER");
                return;
            }
        }

        System.out.println(x + "-" + y + "-" + d);
        sc.close();
    }
}

